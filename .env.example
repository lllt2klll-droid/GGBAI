# Copy thành .env.local và điền giá trị thật. KHÔNG commit .env.local.

# ── AI (bắt buộc cho constructions/edits/image-analysis) ──
# Lấy tại https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional — default gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# ── Supabase (optional — thiếu → fallback localStorage) ──
# supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Auth guard (optional) ──
# true → bắt buộc đăng nhập mới vào được app (cần Supabase env ở trên)
NEXT_PUBLIC_REQUIRE_AUTH=false

# ── Limits ──
UPLOAD_MAX_BYTES=10485760
AI_REQUEST_TIMEOUT_MS=45000
